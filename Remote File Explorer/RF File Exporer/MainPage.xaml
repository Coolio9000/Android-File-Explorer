<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RF_File_Explorer.MainPage"
    Title="Network Share Browser">

    <ContentPage.ToolbarItems>
        <ToolbarItem
        Text="☰"
        Clicked="MenuClicked" />
    </ContentPage.ToolbarItems>

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label
                Text="UNC Path (e.g., \\192.168.1.50\SharedFolder)"
                FontSize="14"
                FontAttributes="Bold" />

                <Entry
                x:Name="UncPathEntry"
                Placeholder="\\server\share"
                Keyboard="Url" 
                Text="pc3.ourhouse.net" />

                <Label
                Text="Username (Optional)"
                FontSize="14"
                FontAttributes="Bold" />

                <Entry
                x:Name="UsernameEntry"
                Placeholder="Domain\\User or Guest"
                Text="MediaUser" />

                <Label
                Text="Password (Optional)"
                FontSize="14"
                FontAttributes="Bold" />

                <Grid ColumnDefinitions="*,Auto">

                    <Entry
                    x:Name="PasswordEntry"
                    Grid.Column="0"
                    Placeholder="Password"
                    IsPassword="True" 
                    Text="IWantMedia" />

                    <Button
                    x:Name="TogglePasswordButton"
                    Grid.Column="1"
                    Text="Show"
                    WidthRequest="70"
                    Clicked="OnTogglePasswordClicked" />

                </Grid>

                <Button
                x:Name="ConnectButton"
                Text="Connect"
                Clicked="OnConnectClicked"
                Margin="0,10,0,0" />

                <Button
                x:Name="UploadButton"
                Text="Upload File"
                Clicked="OnUploadClicked"
                IsEnabled="False" />

                <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False"
                Color="Blue" />

                <Label
                Text="Directory Listing:"
                FontSize="16"
                FontAttributes="Bold"
                Margin="0,15,0,0" />

                <CollectionView
                x:Name="DirectoryCollectionView"
                HeightRequest="300"
                SelectionMode="Single"
                SelectionChanged="DirectoryCollectionView_SelectionChanged">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10">
                                <Label
                                Text="{Binding DisplayName}"
                                FontSize="14" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Drawer Overlay -->
        <Grid
            x:Name="Drawer"
            WidthRequest="280"
            HorizontalOptions="Start"
            BackgroundColor="Black"
            TranslationX="-280">

            <VerticalStackLayout Padding="20">

                <Label
                    Text="Local Locations"
                    FontSize="20"
                    FontAttributes="Bold" />

                <Button
                    Text="Internal Storage"
                    Clicked="InternalStorageClicked" />

                <Button
                    Text="SD Card"
                    Clicked="SdCardClicked" />

                <Label
                    Text="Remote Locations"
                    FontSize="20"
                    Margin="0,20,0,0"
                    FontAttributes="Bold" />

                <Button
                    Text="PC3"
                    Clicked="Pc3Clicked" />

                <Button
                    Text="+ Add Location"
                    Clicked="AddLocationClicked" />

            </VerticalStackLayout>

        </Grid>
        
    </Grid>

</ContentPage>
